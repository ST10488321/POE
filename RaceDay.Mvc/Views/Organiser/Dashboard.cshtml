@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<h1 class="page-title">Organiser dashboard</h1>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card stat-card p-3"><div class="text-muted">Events created</div><div class="num">@Model.TotalEvents</div></div></div>
    <div class="col-md-4"><div class="card stat-card p-3"><div class="text-muted">Total enrolments</div><div class="num">@Model.TotalEnrolments</div></div></div>
    <div class="col-md-4"><div class="card stat-card p-3"><div class="text-muted">Upcoming events</div><div class="num">@Model.UpcomingCount</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <h3>Upcoming dates</h3>
            @if (!Model.Upcoming.Any())
            {
                <p class="text-muted mb-2">No upcoming events yet.</p>
                <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var e in Model.Upcoming)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div><strong>@e.Name</strong><br /><small class="text-muted"><i class="bi bi-calendar3"></i> @e.EventDate.ToString("dd MMM yyyy HH:mm")</small></div>
                            <span class="badge bg-dark">@e.EnrolmentCount enrolled</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2"><h3 class="mb-0">Enrolments per event</h3><a class="btn btn-sm btn-rd" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a></div>
            @if (!Model.Events.Any()) { <p class="text-muted">You have not created any events.</p> }
            else
            {
                <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Event</th><th>Date</th><th>Status</th><th class="text-center">Enrolments</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.Events)
                    {
                        <tr>
                            <td>@e.Name</td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-center fw-bold">@e.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-rd" asp-action="Enrolments" asp-route-id="@e.Id" title="Enrolments"><i class="bi bi-people"></i></a>
                                <a class="btn btn-sm btn-outline-rd" asp-action="Results" asp-route-id="@e.Id" title="Results"><i class="bi bi-stopwatch"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>
</div>
