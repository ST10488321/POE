@model EventFormViewModel
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<h1 class="page-title">@(editing ? "Edit event" : "Create event")</h1>
<div class="card p-4">
    <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="row g-3">
            <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select"><option value="Run">Run</option><option value="Walk">Walk</option><option value="Cycle">Cycle</option></select></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" class="form-control" /><span asp-validation-for="EventDate" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger small"></span></div>
            <div class="col-md-2"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" /><span asp-validation-for="DistanceKm" class="text-danger small"></span></div>
            <div class="col-md-2"><label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"><option value="Open">Open</option><option value="Closed">Closed</option><option value="Cancelled">Cancelled</option></select></div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.BannerImageUrl)) { <div class="mb-2"><img src="@Model.BannerImageUrl" alt="Current banner" style="max-height:140px;border-radius:10px" /></div> }
                <input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" />
                <div class="form-text">Optional. JPG, PNG or WEBP up to 5 MB. Stored in Azure Blob Storage through the API.</div>
            </div>
        </div>
        <div class="mt-4"><button class="btn btn-rd" type="submit">@(editing ? "Save changes" : "Create event")</button> <a class="btn btn-outline-rd" asp-action="Events">Cancel</a></div>
    </form>
</div>
