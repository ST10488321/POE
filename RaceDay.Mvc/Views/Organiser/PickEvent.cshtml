@model EventPickerViewModel
@{ ViewData["Title"] = Model.Title; }
<h1 class="page-title">@Model.Title</h1>
@if (!Model.Events.Any())
{
    <div class="card p-4 text-center"><p class="text-muted">You need an event first.</p><div><a class="btn btn-rd" asp-action="CreateEvent">Create an event</a></div></div>
}
else
{
    <div class="list-group">
        @foreach (var e in Model.Events)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-action="@Model.TargetAction" asp-route-id="@e.Id">
                <span><strong>@e.Name</strong> <small class="text-muted ms-2">@e.EventDate.ToString("dd MMM yyyy")</small></span>
                <span><span class="badge bg-dark me-2">@e.EnrolmentCount enrolled</span><i class="bi bi-chevron-right"></i></span>
            </a>
        }
    </div>
}
