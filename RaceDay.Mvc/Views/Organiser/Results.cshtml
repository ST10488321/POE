@model ResultsPageViewModel
@{ ViewData["Title"] = "Results"; }
<h1 class="page-title">Results - @Model.EventName</h1>
@if (!Model.Rows.Any())
{
    <div class="card p-4 text-center text-muted">No active enrolments to capture results for.</div>
}
else
{
    <div class="alert alert-info"><i class="bi bi-info-circle"></i> Enter the finish time as <strong>hh:mm:ss</strong> (e.g. 00:45:30) and the finishing position. Results are visible to participants as soon as you save.</div>
    <form asp-action="SaveResults" method="post">
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="EventName" />
        <div class="card p-2"><div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Participant</th><th>Category</th><th style="width:170px">Finish time</th><th style="width:120px">Position</th><th>Comments</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <td><strong>@Model.Rows[i].ParticipantName</strong>
                        <input type="hidden" asp-for="Rows[i].EnrolmentId" />
                        <input type="hidden" asp-for="Rows[i].ParticipantName" />
                        <input type="hidden" asp-for="Rows[i].CategoryName" /></td>
                    <td>@Model.Rows[i].CategoryName</td>
                    <td><input asp-for="Rows[i].FinishTime" class="form-control" placeholder="hh:mm:ss" pattern="\d{1,2}:[0-5]\d:[0-5]\d" /></td>
                    <td><input asp-for="Rows[i].Position" type="number" min="1" class="form-control" /></td>
                    <td><input asp-for="Rows[i].Comments" class="form-control" maxlength="500" /></td>
                </tr>
            }
            </tbody>
        </table></div></div>
        <div class="mt-3"><button class="btn btn-rd" type="submit"><i class="bi bi-cloud-upload"></i> Save &amp; publish results</button>
        <a class="btn btn-outline-rd" asp-action="Events">Back to events</a></div>
    </form>
}
