@model EventModel
<div class="card event-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="event-banner" alt="@Model.Name banner" />
    }
    else
    {
        <div class="event-banner-placeholder"><i class="bi @UiHelpers.TypeIcon(Model.Type)"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="type-chip"><i class="bi @UiHelpers.TypeIcon(Model.Type)"></i> @Model.Type</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
        <h3 class="mb-1">@Model.Name</h3>
        <p class="text-muted small mb-2"><i class="bi bi-calendar3"></i> @Model.EventDate.ToString("ddd, dd MMM yyyy HH:mm")<br /><i class="bi bi-geo-alt"></i> @Model.Location<br /><i class="bi bi-signpost-split"></i> @Model.DistanceKm.ToString("0.##") km</p>
        <a asp-controller="Participant" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-rd mt-auto">View &amp; enter</a>
    </div>
</div>
